SENTINELOPS_ENV=local
# Optional fixtures only; default real inference returns 503 until a model exists.
SENTINELOPS_ENABLE_DEMO=false
# CONTROL_DATABASE_URL=postgresql://control_writer:local-control-writer@127.0.0.1:5433/sentinelops_control
# SENTINELOPS_API_TOKEN=  # supply a random token of at least 32 characters locally
# Non-local environments use OIDC instead of static tokens (docs/runbooks/INCIDENT_API.md):
# SENTINELOPS_OIDC_ISSUER= SENTINELOPS_OIDC_AUDIENCE= SENTINELOPS_OIDC_JWKS_URL=
AWS_REGION=ap-southeast-1
# Optional Bedrock inference profile. Verify access and quota in your account
# before enabling it for explanations.
# SENTINELOPS_BEDROCK_REGION=ap-southeast-1
# SENTINELOPS_BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
# OpenAI Responses API (choose this OR Bedrock). Supply the URL, model and key together.
# The deployment tools default to this URL. The adapter requests json_schema output.
# SENTINELOPS_LLM_BASE_URL=https://api.openai.com/v1
# SENTINELOPS_LLM_MODEL=model-name
# SENTINELOPS_LLM_API_KEY=
# Optional for compatible gateways only. Leave unset when calling OpenAI directly.
# SENTINELOPS_LLM_ACTOR_AUTHORIZATION=
# S3_DATASET_BUCKET=
