{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://sentinelops.local/contracts/observation-envelope.schema.json",
  "title": "ObservationEnvelope",
  "properties": {
    "envelope_version": {
      "const": "1.0"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "source_profile": {
      "type": "string",
      "minLength": 1
    },
    "service": {
      "enum": [
        "checkout-service",
        "payment-service",
        "inventory-service"
      ]
    },
    "payload": {
      "type": [
        "object",
        "null"
      ]
    },
    "bucket_start": {
      "type": "string",
      "format": "date-time"
    },
    "bucket_end": {
      "type": "string",
      "format": "date-time"
    },
    "available_at": {
      "type": "string",
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_count",
        "error_count"
      ],
      "properties": {
        "request_count": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "error_count": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "coverage_ratio",
        "eligible_for_inference",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "valid",
            "no_traffic",
            "insufficient_traffic",
            "incomplete",
            "invalid"
          ]
        },
        "coverage_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eligible_for_inference": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_refs"
      ],
      "properties": {
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": [
    "envelope_version",
    "record_id",
    "environment",
    "source_profile",
    "service",
    "payload",
    "bucket_start",
    "bucket_end",
    "available_at",
    "ingested_at",
    "measurements",
    "quality",
    "provenance"
  ]
}
