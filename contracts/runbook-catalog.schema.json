{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelops.local/contracts/runbook-catalog.schema.json",
  "title": "Deterministic runbook catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "thresholds", "entries"],
  "properties": {
    "catalog_version": {"const": "runbook-catalog/v1"},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto_min_score", "auto_min_margin", "oncall_min_score"],
      "properties": {
        "auto_min_score": {"type": "number", "minimum": 0, "maximum": 1},
        "auto_min_margin": {"type": "number", "minimum": 0, "maximum": 1},
        "oncall_min_score": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "field": {"enum": ["symptom_version", "severity", "rca_abstained", "root_service", "affected_services", "modality", "root_p95_ms", "root_error_rate", "latency_band", "onset", "deployment_change", "checkout_impacted", "db_lock"]},
    "value": {"type": ["string", "number", "boolean", "null", "array"], "items": {"type": "string"}},
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "weight"],
      "properties": {
        "field": {"$ref": "#/$defs/field"},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "equals": {"$ref": "#/$defs/value"},
        "in": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/value"}}
      },
      "oneOf": [{"required": ["equals"], "not": {"required": ["in"]}}, {"required": ["in"], "not": {"required": ["equals"]}}]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "executable", "executor_runbook", "allowed_severities", "required", "features", "manual_steps"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "executable": {"type": "boolean"},
        "executor_runbook": {"enum": [null, "payment-rollback-known-good/v1"]},
        "allowed_severities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["low", "medium", "high", "critical"]}},
        "required": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "symptom_version": {"$ref": "#/$defs/value"},
            "severity": {"$ref": "#/$defs/value"},
            "rca_abstained": {"$ref": "#/$defs/value"},
            "root_service": {"$ref": "#/$defs/value"},
            "affected_services": {"$ref": "#/$defs/value"},
            "modality": {"$ref": "#/$defs/value"},
            "root_p95_ms": {"$ref": "#/$defs/value"},
            "root_error_rate": {"$ref": "#/$defs/value"},
            "latency_band": {"$ref": "#/$defs/value"},
            "onset": {"$ref": "#/$defs/value"},
            "deployment_change": {"$ref": "#/$defs/value"},
            "checkout_impacted": {"$ref": "#/$defs/value"},
            "db_lock": {"$ref": "#/$defs/value"}
          }
        },
        "features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/feature"}},
        "manual_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
      },
      "if": {"properties": {"executable": {"const": true}}},
      "then": {"properties": {"executor_runbook": {"const": "payment-rollback-known-good/v1"}}},
      "else": {"properties": {"executor_runbook": {"type": "null"}}}
    }
  }
}
