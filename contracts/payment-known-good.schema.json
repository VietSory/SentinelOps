{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelops.local/contracts/payment-known-good.schema.json",
  "title": "Operator-selected known-good local Payment images, not action permission",
  "type": "object", "additionalProperties": false,
  "required": ["ledger_version", "approved_by", "approved_at", "approval_scope", "action_dispatch_authorized", "images"],
  "properties": {
    "ledger_version": {"const": "approved-payment-images/v1"},
    "approved_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "approved_at": {"type": "string", "format": "date-time"},
    "approval_scope": {"const": "known-good-image-only"},
    "action_dispatch_authorized": {"const": false},
    "images": {"type": "array", "minItems": 1, "maxItems": 20, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "image", "environment", "before_ref", "after_ref", "health_ref"],
      "properties": {
        "target": {"type": "object", "additionalProperties": false,
          "required": ["cluster_uid", "namespace", "namespace_uid", "deployment", "deployment_uid", "container"],
          "properties": {
            "cluster_uid": {"type": "string", "minLength": 1, "maxLength": 128},
            "namespace": {"const": "sentinelops-b-actions"},
            "namespace_uid": {"type": "string", "minLength": 1, "maxLength": 128},
            "deployment": {"const": "payment-service"},
            "deployment_uid": {"type": "string", "minLength": 1, "maxLength": 128},
            "container": {"const": "payment"}
          }},
        "image": {"type": "string", "maxLength": 512, "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[0-9a-f]{64}$"},
        "environment": {"type": "string", "minLength": 1},
        "before_ref": {"$ref": "#/$defs/reference"}, "after_ref": {"$ref": "#/$defs/reference"},
        "health_ref": {"$ref": "#/$defs/reference"}
      }
    }}
  },
  "$defs": {"reference": {"type": "string", "pattern": "^artifact://manifests/[0-9a-f]{64}\\.json$"}}
}
