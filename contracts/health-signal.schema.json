{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelops.local/contracts/health-signal.schema.json",
  "title": "Objective SLO Health Signal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signal_version", "signal_id", "source", "service", "environment", "source_profile", "bucket_end", "evaluated_at", "policy_sha256", "availability", "health", "incident_active", "breach_streak", "clear_streak", "episode_start_at", "episode_confirmed_at", "event", "observation_ref", "evidence_refs", "reasons", "previous_signal_id", "model_outputs_available"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "signal_version": {"const": "slo-health/v1"},
    "signal_id": {"$ref": "#/$defs/hash"},
    "source": {"const": "slo"},
    "service": {"enum": ["checkout-service", "payment-service", "inventory-service"]},
    "environment": {"type": "string", "minLength": 1},
    "source_profile": {"type": "string", "minLength": 1},
    "bucket_end": {"type": "string", "format": "date-time"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "policy_sha256": {"$ref": "#/$defs/hash"},
    "availability": {"enum": ["ELIGIBLE", "UNKNOWN"]},
    "health": {"enum": [null, "healthy", "degrading", "incident", "recovering"]},
    "incident_active": {"type": "boolean"},
    "breach_streak": {"type": "integer", "minimum": 0, "maximum": 3600},
    "clear_streak": {"type": "integer", "minimum": 0, "maximum": 3600},
    "episode_start_at": {"type": ["string", "null"], "format": "date-time"},
    "episode_confirmed_at": {"type": ["string", "null"], "format": "date-time"},
    "event": {"enum": ["observation", "incident_opened", "recovery_confirmed", "data_unknown"]},
    "observation_ref": {"type": ["string", "null"], "pattern": "^artifact://observations/[0-9a-f]{64}\\.json$"},
    "evidence_refs": {"type": "array", "uniqueItems": true, "maxItems": 3600, "items": {"type": "string", "pattern": "^artifact://observations/[0-9a-f]{64}\\.json$"}},
    "reasons": {"type": "array", "uniqueItems": true, "items": {"enum": ["missing_observation", "observation_not_available", "stale_observation", "ineligible_observation", "insufficient_traffic", "insufficient_coverage"]}},
    "previous_signal_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "model_outputs_available": {"const": false}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
