{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelops.local/contracts/rca-result.schema.json",
  "title": "Evidence-linked scored suspected causes",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "rca_version", "mode", "as_of", "policy", "policy_sha256", "correlation", "group_id", "source_refs", "evidence", "evidence_availability", "candidates", "ranking", "margin", "abstained", "abstention_reasons", "actions_allowed", "historical_emissions_verified", "result_id"],
  "properties": {
    "schema_version": {"const": "1.0"}, "rca_version": {"const": "evidence-rca/v1"}, "mode": {"const": "event-time-analytical"},
    "as_of": {"type": "string", "format": "date-time"}, "policy": {"$ref": "https://sentinelops.local/contracts/rca-policy.schema.json"},
    "policy_sha256": {"$ref": "#/$defs/hash"}, "result_id": {"$ref": "#/$defs/hash"}, "group_id": {"$ref": "#/$defs/hash"},
    "correlation": {"$ref": "https://sentinelops.local/contracts/correlation-result.schema.json"},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "maxItems": 2000, "items": {"allOf": [{"$ref": "https://sentinelops.local/contracts/incident-evidence-record.schema.json#/properties/evidence/items"},
      {"required": ["service", "observed_at", "source_ref"], "properties": {"observed_at": {"type": ["string", "null"], "format": "date-time"}, "source_ref": {"type": "string", "minLength": 1}, "fact": {"maxLength": 2048}}}]}},
    "evidence_availability": {"type": "object", "maxProperties": 2000, "additionalProperties": {"type": ["string", "null"], "format": "date-time"}},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["service", "components", "score", "coverage", "evidence_refs"], "properties": {
      "service": {"type": "string", "minLength": 1}, "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "coverage": {"$ref": "#/$defs/unit"}, "evidence_refs": {"$ref": "#/$defs/refs"},
      "components": {"type": "object", "additionalProperties": false, "required": ["anomaly_strength", "temporal_precedence", "dependency_trace_relevance", "log_support", "recent_change_support"], "properties": {
        "anomaly_strength": {"$ref": "#/$defs/component"}, "temporal_precedence": {"$ref": "#/$defs/component"}, "dependency_trace_relevance": {"$ref": "#/$defs/component"}, "log_support": {"$ref": "#/$defs/component"}, "recent_change_support": {"$ref": "#/$defs/component"}}}}}},
    "ranking": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "margin": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "abstained": {"type": "boolean"},
    "abstention_reasons": {"type": "array", "uniqueItems": true, "items": {"enum": ["no-positive-observed-support", "insufficient-score", "insufficient-margin", "insufficient-coverage", "unobserved-dependency-candidates", "source-availability-unverified", "ambiguous-correlation"]}},
    "actions_allowed": {"const": false}, "historical_emissions_verified": {"const": false}
  },
  "$defs": {
    "unit": {"type": "number", "minimum": 0, "maximum": 1}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "component": {"type": "object", "additionalProperties": false, "required": ["value", "method", "evidence_refs", "missing_reason"], "properties": {
      "value": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "method": {"type": "string", "minLength": 1}, "evidence_refs": {"$ref": "#/$defs/refs"}, "missing_reason": {"type": ["string", "null"], "minLength": 1}}}
  }
}
