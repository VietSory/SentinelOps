{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelops.local/contracts/incident-list.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "items",
    "next_cursor"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "incident_id",
          "revision",
          "state",
          "severity",
          "detected_at",
          "affected_services"
        ],
        "properties": {
          "incident_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "state": {
            "enum": [
              "degrading",
              "incident",
              "recovering",
              "recovered",
              "escalated"
            ]
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "detected_at": {
            "type": "string",
            "format": "date-time"
          },
          "affected_services": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    }
  }
}
