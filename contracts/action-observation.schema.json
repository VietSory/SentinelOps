{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelops.local/contracts/action-observation.schema.json",
  "title": "Read-only action journal observation; never an action approval or an IER lifecycle update",
  "type": "object", "additionalProperties": false,
  "required": ["observation_version", "action_id", "incident_id", "incident_revision", "action_revision", "runbook", "phase", "recorded_at", "updated_at", "target", "reason", "before_image", "known_good_image", "history"],
  "properties": {
    "observation_version": {"const": "action-observation/v1"},
    "action_id": {"$ref": "#/$defs/hash"},
    "incident_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "incident_revision": {"type": "integer", "minimum": 1},
    "action_revision": {"type": "integer", "minimum": 1, "maximum": 100},
    "runbook": {"const": "payment-rollback-known-good/v1"},
    "phase": {"$ref": "#/$defs/phase"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "reason": {"type": ["string", "null"], "maxLength": 256},
    "before_image": {"$ref": "#/$defs/image"},
    "known_good_image": {"$ref": "#/$defs/image"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["cluster_uid", "namespace", "namespace_uid", "deployment", "deployment_uid", "container"],
      "properties": {
        "cluster_uid": {"type": "string", "minLength": 1, "maxLength": 128},
        "namespace": {"const": "sentinelops-b-actions"},
        "namespace_uid": {"type": "string", "minLength": 1, "maxLength": 128},
        "deployment": {"const": "payment-service"},
        "deployment_uid": {"type": "string", "minLength": 1, "maxLength": 128},
        "container": {"const": "payment"}
      }
    },
    "history": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["revision", "phase", "recorded_at", "reason", "event_hash", "previous_hash"],
        "properties": {
          "revision": {"type": "integer", "minimum": 1, "maximum": 100},
          "phase": {"$ref": "#/$defs/phase"},
          "recorded_at": {"type": "string", "format": "date-time"},
          "reason": {"type": ["string", "null"], "maxLength": 256},
          "event_hash": {"$ref": "#/$defs/hash"},
          "previous_hash": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "phase": {"enum": ["prepared", "blocked", "dispatching", "verifying", "recovered", "escalated"]},
    "image": {"type": ["string", "null"], "maxLength": 512, "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[0-9a-f]{64}$"}
  }
}
