{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelops.local/contracts/correlation-result.schema.json",
  "title": "Conservative SLO Episode Correlation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "correlation_version", "result_id", "mode", "as_of", "window_seconds", "source_scope_sha256", "topology_sha256", "topology_snapshot", "source_identity", "input_signal_ids", "opening_signal_ids", "opening_facts", "duplicate_count", "future_count", "non_opening_count", "groups", "historical_emissions_verified", "rca_evaluated", "actions_allowed"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "correlation_version": {"const": "slo-topology/v1"},
    "result_id": {"$ref": "#/$defs/hash"},
    "mode": {"const": "event-time-analytical"},
    "as_of": {"type": "string", "format": "date-time"},
    "window_seconds": {"const": 120},
    "source_scope_sha256": {"$ref": "#/$defs/hash"},
    "topology_sha256": {"$ref": "#/$defs/hash"},
    "topology_snapshot": {"type": "object", "additionalProperties": false, "required": ["version", "dependencies"], "properties": {
      "version": {"type": "integer", "minimum": 1}, "dependencies": {"type": "object", "minProperties": 1, "maxProperties": 100, "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}}}},
    "source_identity": {"type": ["array", "null"], "minItems": 3, "maxItems": 3, "prefixItems": [{"$ref": "#/$defs/name"}, {"$ref": "#/$defs/name"}, {"$ref": "#/$defs/hash"}], "items": false},
    "input_signal_ids": {"$ref": "#/$defs/hashes"},
    "opening_signal_ids": {"$ref": "#/$defs/hashes"},
    "opening_facts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["signal_id", "service", "episode_start_at", "evaluated_at"], "properties": {
      "signal_id": {"$ref": "#/$defs/hash"}, "service": {"$ref": "#/$defs/name"},
      "episode_start_at": {"type": "string", "format": "date-time"}, "evaluated_at": {"type": "string", "format": "date-time"}}}},
    "duplicate_count": {"type": "integer", "minimum": 0},
    "future_count": {"type": "integer", "minimum": 0},
    "non_opening_count": {"type": "integer", "minimum": 0},
    "groups": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["group_id", "signal_ids", "affected_services", "first_onset_at", "last_onset_at", "structural_candidates", "grouping_reason", "dependency_support", "topology_sha256", "source_scope_sha256"],
      "properties": {
        "group_id": {"$ref": "#/$defs/hash"}, "signal_ids": {"$ref": "#/$defs/nonemptyHashes"},
        "affected_services": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
        "first_onset_at": {"type": "string", "format": "date-time"}, "last_onset_at": {"type": "string", "format": "date-time"},
        "structural_candidates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
        "grouping_reason": {"enum": ["single-service", "dependency-path", "ambiguous-shared-consumer"]},
        "dependency_support": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["consumer", "dependency", "path", "candidate_signal_id"], "properties": {
          "consumer": {"$ref": "#/$defs/name"}, "dependency": {"$ref": "#/$defs/name"}, "candidate_signal_id": {"$ref": "#/$defs/hash"},
          "path": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}}}},
        "topology_sha256": {"$ref": "#/$defs/hash"}, "source_scope_sha256": {"$ref": "#/$defs/hash"}}}},
    "historical_emissions_verified": {"const": false}, "rca_evaluated": {"const": false}, "actions_allowed": {"const": false}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "name": {"type": "string", "minLength": 1},
    "hashes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
    "nonemptyHashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}}
  }
}
