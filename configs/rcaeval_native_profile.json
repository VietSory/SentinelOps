{
  "profile_version": "rcaeval-native/v1",
  "revision": "afeacb11bcc94dadfd1c8f483ee4377b2b8b614e",
  "access": "previously-inspected-development-only",
  "clock_mode": "source-event-time-only",
  "analysis_window_seconds": 300,
  "cutoff": "last-metric-second-plus-one",
  "metric_time_unit": "unix-seconds",
  "log_time_unit": "unix-seconds-verified-against-metric-capture",
  "trace_start_unit": "unix-microseconds",
  "trace_duration_unit": "microseconds",
  "trace_millisecond_pair": "startTimeMillis == startTime // 1000",
  "native_status_code": "preserve-only-no-http-or-rpc-interpretation",
  "entity_mapping": "exact-native-identities-no-aliases",
  "maximum_manifest_bytes": 262144,
  "maximum_file_bytes": 134217728,
  "maximum_total_file_bytes": 536870912,
  "maximum_rows_per_table": 3000000,
  "maximum_metric_columns": 512,
  "maximum_decoded_bytes_per_table": 536870912,
  "batch_rows": 4096,
  "exception_markers": [
    "\\b[A-Za-z_][A-Za-z0-9_.]*(?:Exception|Error)\\b",
    "^Traceback \\(most recent call last\\):",
    "^(?:panic:|fatal error:|Unhandled exception\\b)"
  ],
  "exception_marker_flags": "MULTILINE-case-sensitive",
  "trace_support_method": "native-observed-span-duration-fraction/v1",
  "log_support_method": "native-exception-marker-presence/v1",
  "missing_receipt_clocks": "unverified-not-reconstructed",
  "anomaly_model_support": "unavailable-no-approved-source-compatible-model",
  "temporal_onset_support": "unavailable-no-objective-SLO-onsets",
  "deployment_change_support": "unavailable-no-observed-deployment",
  "ml_fitting_allowed": false,
  "live_rca_compatible": false,
  "actions_allowed": false,
  "maximum_entities": 512,
  "maximum_unique_span_ids": 1000000
}
