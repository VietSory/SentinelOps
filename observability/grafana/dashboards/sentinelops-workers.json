{
  "uid": "sentinelops-workers",
  "title": "SentinelOps — worker telemetry",
  "description": "Liveness, source eligibility and progress of the health/incident workers. Worker telemetry only: not business/SLO health, not model quality, not RCA accuracy, and no panel authorizes an action.",
  "tags": ["sentinelops", "worker-telemetry"],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "sentinelops-prometheus" },
        "query": "label_values(sentinelops_worker_ready, environment)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      },
      {
        "name": "job",
        "label": "Worker",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "sentinelops-prometheus" },
        "query": "label_values(sentinelops_worker_ready{environment=\"$environment\"}, job)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Scope",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**Worker telemetry only.** These panels show what the health and incident workers reported about themselves. They are **not** business or SLO health, **not** model quality, and **not** RCA accuracy. No panel grants model activation or remediation authority.\n\n**Missing data is UNKNOWN, never healthy.** An absent series renders as `UNKNOWN` or `NOT DECIDED`, never as zero. Source eligibility is read only for a replica that committed a local decision; a replica that has not decided is shown as `NOT DECIDED`, not as an unavailable source.\n\nAbsence of an accepted model is expected: `/ready` returning 503 for that reason is not a fault and is deliberately not shown as one."
      }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Replicas with a stale heartbeat",
      "description": "Heartbeat older than 15s. Reads zero only when replicas are actually observed; when no replica reports at all the panel shows UNKNOWN instead of zero, because an absent series is not evidence of health. These replicas are UNKNOWN; it does not mean the monitored services are unhealthy.",
      "datasource": { "type": "prometheus", "uid": "sentinelops-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sentinelops:worker_heartbeat_age_seconds{environment=\"$environment\", job=~\"$job\"} > 15) or (count(sentinelops:worker_heartbeat_age_seconds{environment=\"$environment\", job=~\"$job\"}) * 0)",
          "instant": true,
          "legendFormat": "stale"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN — no replica reporting",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 1 }
          ] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Replica readiness",
      "description": "Reported readiness per replica. A clean shutdown also reports NOT READY, so confirm the intended lifecycle.",
      "datasource": { "type": "prometheus", "uid": "sentinelops-prometheus" },
      "gridPos": { "h": 5, "w": 10, "x": 6, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinelops_worker_ready{environment=\"$environment\", job=~\"$job\"}",
          "instant": true,
          "legendFormat": "{{worker_instance}}"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "colorMode": "value", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "noValue": "UNKNOWN",
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "1": { "text": "READY", "color": "green", "index": 0 }, "0": { "text": "NOT READY", "color": "orange", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Incident consumer local progress",
      "description": "Whether the consumer recorded local progress. An idle consumer with no new source steps is expected and does not mean correlation or RCA failed.",
      "datasource": { "type": "prometheus", "uid": "sentinelops-prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinelops_incident_has_local_progress{environment=\"$environment\"}",
          "instant": true,
          "legendFormat": "{{worker_instance}}"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "colorMode": "value", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "noValue": "UNKNOWN",
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "1": { "text": "PROGRESS", "color": "green", "index": 0 }, "0": { "text": "NO PROGRESS", "color": "text", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      }
    },

    {
      "id": 5,
      "type": "timeseries",
      "title": "Heartbeat age per replica",
      "description": "Seconds since each replica last published a main-loop heartbeat. The 15s threshold is the staleness alert boundary.",
      "datasource": { "type": "prometheus", "uid": "sentinelops-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinelops:worker_heartbeat_age_seconds{environment=\"$environment\", job=~\"$job\"}",
          "legendFormat": "{{worker_instance}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": false,
            "thresholdsStyle": { "mode": "line" } },
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "transparent", "value": null },
            { "color": "orange", "value": 15 }
          ] }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Source eligibility for decided replicas",
      "description": "Reads sentinelops:worker_source_available:decided, which is guarded by has_local_decision == 1. A replica that has not committed a decision shows NOT DECIDED rather than an unavailable source. Value 0 means availability is UNKNOWN for that decided bucket, which is not a detected incident.",
      "datasource": { "type": "prometheus", "uid": "sentinelops-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinelops:worker_source_available:decided{environment=\"$environment\", job=~\"$job\"}",
          "legendFormat": "{{worker_instance}} / {{business_service}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single" },
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.9
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "NOT DECIDED",
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "1": { "text": "ELIGIBLE", "color": "green", "index": 0 }, "0": { "text": "UNKNOWN", "color": "orange", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "custom": { "fillOpacity": 80, "lineWidth": 0 }
        },
        "overrides": []
      }
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Committed windows",
      "description": "Rate of accepted decisions per replica. Zero means no new decision was committed, which for a backlogged or idle worker is expected.",
      "datasource": { "type": "prometheus", "uid": "sentinelops-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(sentinelops_worker_committed_windows_total{environment=\"$environment\", job=~\"$job\"}[5m])",
          "legendFormat": "{{worker_instance}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Worker errors by component",
      "description": "Worker-side failures in the fixed component taxonomy. These are not business request failures.",
      "datasource": { "type": "prometheus", "uid": "sentinelops-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component) (rate(sentinelops_worker_errors_total{environment=\"$environment\", job=~\"$job\"}[5m]))",
          "legendFormat": "{{component}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "UNKNOWN decisions by service",
      "description": "Rate at which a business service was recorded as not ELIGIBLE in a decision. UNKNOWN availability is neither healthy nor a detected incident.",
      "datasource": { "type": "prometheus", "uid": "sentinelops-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (business_service) (rate(sentinelops_worker_unknown_decisions_total{environment=\"$environment\", job=~\"$job\"}[5m]))",
          "legendFormat": "{{business_service}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Decision processing duration (p95)",
      "description": "Estimated from the worker histogram. A quantile over few observations is noisy; read it as an order of magnitude, not a measured SLO.",
      "datasource": { "type": "prometheus", "uid": "sentinelops-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(sentinelops_worker_processing_duration_seconds_bucket{environment=\"$environment\", job=~\"$job\"}[10m])))",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": false },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Incident groups and RCA abstentions",
      "description": "Correlation output volume and how often RCA abstained. An abstention is a correct conservative outcome, not a failure.",
      "datasource": { "type": "prometheus", "uid": "sentinelops-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sentinelops_incident_groups_total{environment=\"$environment\"}[5m]))",
          "legendFormat": "incident groups"
        },
        {
          "refId": "B",
          "expr": "sum(rate(sentinelops_rca_abstentions_total{environment=\"$environment\"}[5m]))",
          "legendFormat": "RCA abstentions"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    }
  ]
}
