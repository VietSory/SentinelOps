    {
      "id": 4,
      "type": "timeseries",
      "title": "Độ trễ p95 theo dịch vụ — ngưỡng 750 ms",
      "description": "Recording rule đã có đơn vị mili giây, không nhân 1.000. P95 trên cửa sổ 5 phút; đường đỏ ở 750 ms. Khoảng trống là thiếu dữ liệu. Đọc cùng lưu lượng vì mẫu ít có thể làm p95 dao động. Telemetry không còn cập nhật trong 2 phút được để trống.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelops-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinelops:http_latency_p95_ms{service=~\"checkout-service|payment-service|inventory-service\"} and on (service) (sentinelops:http_latency_telemetry_age_seconds < 120)",
          "range": true,
          "instant": false,
          "legendFormat": "{{service}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "KHÔNG CÓ DỮ LIỆU",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "left",
            "axisLabel": "Độ trễ p95 (ms)",
            "axisBorderShow": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 750
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "checkout-service"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "payment-service"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "inventory-service"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "cyan"
                }
              }
            ]
          }
        ]
      }
    },
    {
